# TerraNex AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Supabase Configuration ─────────────────────────────────────────────────────
# Required for Supabase data layer. If absent, the app falls back to static JSON.

# --- Server-side (Express API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side ONLY — NEVER expose this to the browser or client bundle.
# Used by Express server routes for write operations (interventions, sync refresh).
# Used by scripts/seed-supabase.js to seed the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Frontend / Vite (browser-safe) ---
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Use the ANON key — never the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
