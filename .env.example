# TerraNex AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Supabase Configuration ─────────────────────────────────────────────────────
# Required for Supabase data layer. If absent, the app falls back to static JSON.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER expose this to the browser or client bundle.
# Used by Express server routes for write operations (interventions, sync refresh).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
